      "glob@>=10.0.0 <10.5.0": "^10.5.0",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "minimatch@>=3.0.0 <3.1.4": "^3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "serialize-javascript@>=6.0.0 <7.0.0": "^7.0.5",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "flatted@>=3.0.0 <3.4.2": "^3.4.2",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "uuid@>=10.0.0 <11.0.0": "^11.1.1",
      "uuid@>=9.0.0 <10.0.0": "^11.1.1",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "file-type@>=20.0.0 <21.0.0": "^21.3.2"
    }
  }
}